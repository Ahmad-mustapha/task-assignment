# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — secrets stay local; .env.example is committed as the template
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma — generated client, rebuilt by `pnpm db:generate`
/src/generated/

# other package managers (this project uses pnpm)
package-lock.json
yarn.lock

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# os
Thumbs.db

# agent tooling — regenerated by `next dev`
.agents/
.claude/
.cursor/
.devin/

# next dev regenerates these on every run
AGENTS.md
CLAUDE.md
